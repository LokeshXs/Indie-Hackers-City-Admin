# The admin console talks to LOCAL Supabase during development -- the same local stack the city
# app uses, because they share one database. Copy this file to `.env.local`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Comma-separated. A signed-in Google account whose verified address is on this list is an admin;
# every other account is refused. Case and surrounding spaces are ignored. There is no wildcard and
# no default -- an empty list locks everyone out, which is the safe direction to fail.
ADMIN_EMAILS=

# Supabase secret key (formerly the service_role key). This bypasses every RLS policy, so it is
# READ AND WRITTEN ONLY ON THE SERVER and must never carry a NEXT_PUBLIC_ prefix.
# Get the local value from the city repo with: npx supabase status
SUPABASE_SECRET_KEY=
