# Hosted Supabase -- the same project the deployed city app uses. Copy to `.env` and take the two
# public values from the city repo's `.env`, or from the Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated allow-list of admin Google addresses. See the note in .env.local.example.
ADMIN_EMAILS=

# Supabase secret key for the HOSTED project: Dashboard -> Project Settings -> API keys.
# It bypasses RLS. Server-side only, never NEXT_PUBLIC_, never committed.
SUPABASE_SECRET_KEY=
